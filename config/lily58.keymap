#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers

#define Base       0
#define Nav        1
#define Symbols    2
#define Functions  3
#define Mouse      4
#define Gaming     5
#define System     6

/ {
    macros {
        tmx: tmux_prefix {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LC(A)>,
                       <&macro_param_1to1>,
                       <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        tm: thumb_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
            require-prior-idle-ms = <100>;  // 連打時 Space/Enter 一律當 tap，避免誤觸 Shift/Ctrl
        };

        em: enter_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        
        lh: layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &kp ESC    &kp N1  &kp N2  &kp N3     &kp N4        &kp N5                                         &kp N6        &kp N7     &kp N8     &kp N9   &kp N0    &kp LG(ESC)
                &kp TAB    &kp Q   &kp W   &kp E      &kp R         &kp T                                          &kp Y         &kp U      &kp I      &kp O    &kp P     &kp LC(TAB)
                &kp LSHFT  &kp A   &kp S   &kp D      &kp F         &kp G                                          &kp H         &kp J      &kp K      &kp L    &kp SEMI  &kp C_PLAY_PAUSE
                &kp LCTRL  &kp Z   &kp X   &kp C      &kp V         &kp B        &kp LG(LS(F))      &kp LG(SPACE)  &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp DEL
                                           &kp LMETA  &tm LALT ESC  &mo Symbols  &tm LSHFT SPACE    &em LCTRL RET  &lh Nav BSPC  &kp RMETA  &none
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                &trans         &kp LG(N1)      &kp LG(N2)       &kp LG(N3)      &kp LG(N4)      &kp LG(N5)                        &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)      &trans
                &trans         &kp LG(LS(N1))  &kp LG(LS(N2))   &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))                    &kp LG(LS(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))  &kp LG(LS(N0))  &trans
                &kp LA(PSCRN)  &kp PSCRN       &kp LG(I)        &kp LG(F)       &kp HOME        &kp PG_UP                         &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp LG(TAB)     &kp LG(LS(TAB))
                &trans         &kp LG(RET)     &kp LG(LS(RET))  &kp LG(LA(F))   &kp END         &kp PG_DN       &trans    &trans  &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV      &kp C_NEXT      &trans          &trans
                                                                &trans          &trans          &trans          &trans    &trans  &trans          &trans          &trans
            >;
        };

        Symbols {
            display-name = "Symbols";
            bindings = <
                &trans  &trans    &trans      &trans     &trans     &trans                       &trans     &trans    &trans    &trans    &trans         &trans
                &trans  &kp EXCL  &kp AT      &kp HASH   &kp DLLR   &kp PRCNT                    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR       &trans
                &trans  &tmx W    &tmx PIPE   &kp GRAVE  &kp MINUS  &kp EQUAL                    &kp LBRC   &kp RBRC  &kp SQT   &kp DQT   &kp LC(LA(B))  &trans
                &trans  &tmx C    &tmx MINUS  &kp TILDE  &kp PLUS   &kp UNDER  &trans    &trans  &kp LBKT   &kp RBKT  &kp PIPE  &kp BSLH  &trans         &trans
                                              &trans     &trans     &trans     &trans    &trans  &trans     &trans    &trans
            >;
        };

        Functions {
            display-name = "Functions";
            bindings = <
                &trans  &kp F1  &kp F2   &kp F3   &kp F4  &kp F5                       &kp F6      &kp F7     &kp F8     &kp F9  &kp F10    &trans
                &trans  &trans  &kp F11  &kp F12  &trans  &trans                       &trans      &trans     &trans     &trans  &trans     &trans
                &trans  &trans  &trans   &trans   &trans  &trans                       &trans      &kp LA(J)  &kp LA(K)  &trans  &kp LG(W)  &trans
                &trans  &trans  &trans   &trans   &trans  &to Mouse  &trans    &trans  &to System  &trans     &trans     &trans  &trans     &trans
                                         &trans   &trans  &trans     &trans    &trans  &trans      &trans     &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
                &kp ESC  &none  &none  &none  &none        &none                         &none           &none           &none         &none            &none  &none
                &none    &none  &none  &none  &none        &none                         &none           &none           &none         &none            &none  &none
                &none    &none  &none  &none  &none        &none                         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
                &none    &none  &none  &none  &none        &none  &none       &none      &none           &msc SCRL_DOWN  &msc SCRL_UP  &none            &none  &none
                                       &none  &to Gaming   &none  &to Base    &mkp LCLK  &mkp RCLK       &mkp MCLK       &none
            >;
        };

        Gaming {
            display-name = "Gaming";
            bindings = <
                &kp ESC    &kp N1     &kp N2  &kp N3   &kp N4  &kp N5                           &none         &none         &none  &none  &none  &none
                &none      &kp Q      &none   &kp W    &kp E   &kp R                            &none         &none         &none  &none  &none  &none
                &kp LCTRL  &kp LSHFT  &kp A   &kp S    &kp D   &none                            &none         &none         &none  &none  &none  &none
                &kp G      &kp N6     &kp N7  &kp N8   &kp N9  &kp N0  &kp B        &to System  &kp C_VOL_DN  &kp C_VOL_UP  &none  &none  &none  &none
                                              &kp TAB  &kp M   &kp Z   &kp SPACE    &to Base    &none         &to Mouse     &none
            >;
        };

        System {
            display-name = "System";
            bindings = <
                &studio_unlock  &none  &none  &none  &none        &bt BT_CLR                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
                &none           &none  &none  &none  &none        &none                               &none         &none         &none         &none         &none         &none
                &none           &none  &none  &none  &none        &sys_reset                          &sys_reset    &none         &none         &none         &kp LG(W)     &none
                &none           &none  &none  &none  &none        &bootloader  &none       &to Mouse  &bootloader   &none         &none         &none         &none         &none
                                              &none  &to Gaming   &none        &to Base    &none      &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        functions {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
